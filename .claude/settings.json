{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list)",
      "Bash(rg *)",
      "Bash(py -3 scripts/ci/validate_agent_setup.py *)",
      "Bash(python3 scripts/ci/validate_agent_setup.py *)",
      "Bash(py -3 scripts/agents/guard.py *)",
      "Bash(python3 scripts/agents/guard.py *)",
      "Bash(py -3 tools/repository-map/resolve_graph_out.py *)",
      "Bash(python3 tools/repository-map/resolve_graph_out.py *)",
      "Bash(memory *)",
      "Bash(mempalace *)",
      "mcp__shaft-memory__load_memory",
      "mcp__shaft-memory__search_memory",
      "mcp__shaft-memory__inspect_memory"
    ],
    "ask": [
      "mcp__shaft-memory__remember_memory"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|shell_command|mcp__shaft-memory__(remember_memory|save_memory_patch)",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-c",
              "import pathlib,runpy;p=next(p/'scripts/agents/guard.py' for p in (pathlib.Path.cwd(),*pathlib.Path.cwd().parents) if (p/'scripts/agents/guard.py').is_file());runpy.run_path(str(p),run_name='__main__')"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-c",
              "import pathlib,runpy;p=next(p/'scripts/agents/guard.py' for p in (pathlib.Path.cwd(),*pathlib.Path.cwd().parents) if (p/'scripts/agents/guard.py').is_file());runpy.run_path(str(p),run_name='__main__')"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-c",
              "import pathlib,runpy;p=next(p/'scripts/agents/guard.py' for p in (pathlib.Path.cwd(),*pathlib.Path.cwd().parents) if (p/'scripts/agents/guard.py').is_file());runpy.run_path(str(p),run_name='__main__')"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true
  }
}
