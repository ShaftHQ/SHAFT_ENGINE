    },
    "shaft skill routing": {
      "owner": "shaft-skills/shaft-developer/SKILL.md",
      "terms": ["select exactly one lifecycle implementation or tool specialist", "desktop automation has no skill"]
    },
    "CI aggregation": {
      "owner": "scripts/ci/validate_agent_setup.py",
      "terms": ["validate_repository", "collect_metrics", "collect_worktree_metrics"]
    },
    "promotion evaluation": {
      "owner": "scripts/ci/chaos_engine_promotion.py",
