      "allowed": [
        "scripts/ci/chaos_engine_promotion_trials.py",
        "tests/scripts/test_chaos_engine_promotion.py"
      ]
    },
    "ChaosGauge evaluation": {
      "owner": "scripts/ci/chaos_gauge/compare_results.py",
      "terms": ["task-paired bootstrap inference", "SCORE_VERSION"],
      "allowed": [
        "scripts/ci/chaos_gauge/validate_experiment.py",
        "scripts/ci/chaos_gauge/dataset/metric.py",
        "tests/scripts/test_chaos_gauge_contracts.py",
        "tests/scripts/test_chaos_gauge_corpus.py",
        "tests/scripts/test_chaos_gauge_scoring.py"
      ]
    },
    "Markdown harness map": {
      "owner": ".agents/skills/README.md",
      "terms": ["Every harness element", "reachable from the entrypoint", "assertions themselves are unit tests"]
    },
    "repository adapter": {
      "owner": "AGENTS.md",
      "terms": ["SHAFT_ENGINE Maven Java automation framework", "Repository safety", "Canonical policy"]
    }
  },
  "adapters": [
    "AGENTS.md",
    "CLAUDE.md",
    ".github/copilot-instructions.md",
    "GEMINI.md"
  ]
}
