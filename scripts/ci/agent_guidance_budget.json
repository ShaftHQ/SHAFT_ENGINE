{
  "limit_sources": {
    "max_always_loaded_body_chars": "Codex concatenates AGENTS.md layers up to project_doc_max_bytes (32768 bytes) and stops at the cap. Capped at half so no host approaches truncation.",
    "max_skill_listing_chars": "Codex renders its skill listing in at most 8000 characters when the context window is unknown, and omits skills entirely on overflow. Capped at half.",
    "max_description_chars": "Agent Skills spec caps description at 1024 characters; Claude Code truncates description plus when_to_use at 1536. Capped tighter so the aggregate listing ceiling binds first.",
    "max_skill_md_bytes": "Agent Skills spec recommends a SKILL.md body under 5000 tokens, and Claude Code re-attaches only the first 5000 tokens of an invoked skill after auto-compaction. 20000 characters approximates that window.",
    "max_skill_md_lines": "Agent Skills spec: keep SKILL.md under 500 lines so a host never truncates it.",
    "measurement": "Characters, not estimated tokens: hosts budget their listings in characters, and a chars/4 proxy adds false precision. Counts are LF-normalized via read_text()."
  },
  "max_always_loaded_body_chars": 16384,
  "max_skill_listing_chars": 4000,
  "file_budgets": {
    "AGENTS.md": {
      "max_bytes": 6528
    },
    "CLAUDE.md": {
      "max_bytes": 1536,
      "max_lines": 40
    },
    ".github/copilot-instructions.md": {
      "max_chars": 1500
    },
    ".github/instructions/framework-source.instructions.md": {
      "max_chars": 3999
    },
    ".github/instructions/java-tests.instructions.md": {
      "max_chars": 3999
    },
    "shaft-mcp/.github/copilot-instructions.md": {
      "max_chars": 1500
    }
  },
  "host_contexts": {
    "codex": [
      "AGENTS.md",
      ".agents/skills/act-as-mohab/SKILL.md"
    ],
    "claude": [
      "AGENTS.md",
      "CLAUDE.md",
      ".agents/skills/act-as-mohab/SKILL.md"
    ],
    "grok": [
      "AGENTS.md",
      "CLAUDE.md",
      ".agents/skills/act-as-mohab/SKILL.md"
    ],
    "copilot": [
      "AGENTS.md",
      ".github/copilot-instructions.md",
      ".github/instructions/framework-source.instructions.md",
      ".github/instructions/java-tests.instructions.md",
      ".agents/skills/act-as-mohab/SKILL.md"
    ]
  },
  "host_skill_metadata_globs": {
    "codex": [
      ".agents/skills/*/SKILL.md"
    ],
    "claude": [
      ".claude/skills/*/SKILL.md",
      ".claude/agents/*.md"
    ],
    "grok": [
      ".claude/skills/*/SKILL.md",
      ".claude/agents/*.md"
    ]
  },
  "routing_bridges": {
    "source": ".agents/skills/act-as-mohab/references/routing.md",
    "skill_roots": [
      ".agents/skills",
      ".claude/skills",
      "shaft-skills"
    ],
    "names": [
      "consult-first",
      "shaft-developer"
    ]
  },
  "active_guidance_globs": [
    "AGENTS.md",
    "CLAUDE.md",
    ".agents/skills/*/SKILL.md",
    ".agents/skills/*/agents/openai.yaml",
    ".agents/skills/act-as-mohab/references/**/*.md",
    ".claude/agents/*.md",
    ".claude/skills/*/SKILL.md",
    ".github/copilot-instructions.md",
    ".github/instructions/*.instructions.md",
    ".github/skills/*/SKILL.md"
  ],
  "total_guidance_globs": [
    "AGENTS.md",
    "CLAUDE.md",
    ".agents/skills/*/SKILL.md",
    ".agents/skills/act-as-mohab/references/**/*.md",
    ".claude/agents/*.md",
    ".claude/skills/*/SKILL.md",
    ".github/copilot-instructions.md",
    ".github/instructions/*.instructions.md",
    ".github/skills/README.md",
    ".github/skills/*/SKILL.md"
  ],
  "expected_skill_names": {
    ".agents/skills": [
      "act-as-mohab",
      "consult-first"
    ],
    ".claude/skills": [
      "act-as-mohab",
      "consult-first"
    ],
    ".github/skills": [
      "agent-guidance-boundary-guard",
      "agentic-pdca-loop",
      "allure-extent-report-operator",
      "ci-failure-investigator",
      "flaky-test-stabilizer",
