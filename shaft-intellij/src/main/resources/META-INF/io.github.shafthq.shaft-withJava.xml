<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Only needs Java PSI (method annotations); the JUnit/TestNG run-configuration producers
             that actually create run configurations live in their own optional-dependency files
             below because JUnitConfiguration/TestNGConfiguration classes belong to the separate
             bundled "JUnit" and "TestNG-J" plugins, not to com.intellij.java itself. -->
        <runLineMarkerContributor language="JAVA"
                   implementationClass="com.shaft.intellij.testrunner.ShaftTestLineMarkerContributor"/>
        <!-- Editor intelligence (issues #6418, #6419, #6420). -->
        <localInspection language="JAVA" shortName="ShaftThreadSleep" displayName="Thread.sleep in a SHAFT test"
                         groupName="SHAFT" enabledByDefault="true" level="WARNING"
                         implementationClass="com.shaft.intellij.inspections.ShaftThreadSleepInspection"/>
        <localInspection language="JAVA" shortName="ShaftDeprecatedApi" displayName="Deprecated SHAFT API usage"
                         groupName="SHAFT" enabledByDefault="true" level="WARNING"
                         implementationClass="com.shaft.intellij.inspections.ShaftDeprecatedApiInspection"/>
        <lang.documentationProvider language="JAVA"
                                    implementationClass="com.shaft.intellij.inspections.ShaftApiDocumentationProvider"/>
        <defaultLiveTemplates file="liveTemplates/SHAFT.xml"/>
        <!-- Live match count for By.* locators (issue #6421). -->
        <codeInsight.lineMarkerProvider language="JAVA"
                implementationClass="com.shaft.intellij.locators.LocatorMatchCountLineMarkerProvider"/>
        <!-- Last-run status and duration per test method (issue #6424). -->
        <codeInsight.declarativeInlayProvider language="JAVA" providerId="shaft.lastRun"
                implementationClass="com.shaft.intellij.testindex.LastRunInlayHintsProvider"
                isEnabledByDefault="true" group="OTHER_GROUP" bundle="messages.ShaftBundle"
                nameKey="inlay.shaft.lastRun.name" descriptionKey="inlay.shaft.lastRun.description"/>
        <!-- Fix with SHAFT Assistant on a line where the last run failed (issue #6636). -->
        <intentionAction>
            <language>JAVA</language>
            <className>com.shaft.intellij.actions.FixWithShaftAssistantIntention</className>
            <category>SHAFT</category>
        </intentionAction>
    </extensions>
    <actions>
        <action id="Shaft.RecordJavaTarget"
                class="com.shaft.intellij.actions.RecordShaftFlowHereAction"
                text="Record SHAFT Flow Here"
                description="Start a live SHAFT recording anchored at the current Java context"
                icon="/icons/shaftToolWindow.svg"
                iconDark="/icons/shaftToolWindow_dark.svg">
            <add-to-group group-id="Shaft.ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="Shaft.PickLocatorAtCaret"
                class="com.shaft.intellij.actions.PickLocatorAtCaretAction"
                text="Pick Locator from Live Session"
                description="Insert a SHAFT.GUI.Locator snippet at the caret from the live capture_pick_locator MCP tool"
                icon="/icons/shaftToolWindow.svg"
                iconDark="/icons/shaftToolWindow_dark.svg">
            <add-to-group group-id="Shaft.ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="Shaft.RecordApiWeb"
                class="com.shaft.intellij.actions.RecordApiWebAction"
                text="Record SHAFT API + Web Session"
                description="Start a SHAFT API/web recording session via the capture_api_start MCP tool"
                icon="/icons/shaftToolWindow.svg"
                iconDark="/icons/shaftToolWindow_dark.svg">
            <add-to-group group-id="Shaft.ToolsMenu" anchor="last"/>
        </action>
        <action id="Shaft.RecordApiMobile"
                class="com.shaft.intellij.actions.RecordApiMobileAction"
                text="Record SHAFT API Session (No Browser)"
                description="Start a no-browser mobile API recording session via the mobile_api_record_start MCP tool"
                icon="/icons/shaftToolWindow.svg"
                iconDark="/icons/shaftToolWindow_dark.svg">
            <add-to-group group-id="Shaft.ToolsMenu" anchor="last"/>
        </action>
        <action id="Shaft.GoToLastFailure"
                class="com.shaft.intellij.actions.GoToLastFailureAction"
                text="Go to Last SHAFT Failure"
                description="Open the failing line of a test from the newest allure-results"
                icon="/icons/shaftToolWindow.svg"
                iconDark="/icons/shaftToolWindow_dark.svg">
            <add-to-group group-id="Shaft.ToolsMenu" anchor="last"/>
        </action>
        <action id="Shaft.GeneratePageObjectFromCapture"
                class="com.shaft.intellij.actions.GeneratePageObjectFromCaptureAction"
                text="Generate Page Object from Capture"
                description="Preview and create a Page Object from the newest Capture recording (capture_code_blocks)"
                icon="/icons/shaftToolWindow.svg"
                iconDark="/icons/shaftToolWindow_dark.svg">
            <add-to-group group-id="Shaft.ToolsMenu" anchor="last"/>
        </action>
        <action id="Shaft.ShowTraceViewer"
                class="com.shaft.intellij.actions.ShowTraceViewerAction"
                text="Show SHAFT Trace Viewer"
                description="Open the latest SHAFT failure trace viewer in your browser"
                icon="/icons/shaftToolWindow.svg"
                iconDark="/icons/shaftToolWindow_dark.svg">
            <add-to-group group-id="Shaft.ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
