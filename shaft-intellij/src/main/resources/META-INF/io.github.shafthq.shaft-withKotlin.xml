<!-- Optional Kotlin integration (#6427): the UAST-based SHAFT gutter also covers Kotlin tests. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <runLineMarkerContributor language="kotlin"
                   implementationClass="com.shaft.intellij.testrunner.ShaftTestLineMarkerContributor"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
