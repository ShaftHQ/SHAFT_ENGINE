{
  "mcpServers": {
    "chaosengine-memory": {
      "args": [
        ".chaos-engine/tool.py",
        "memory-mcp"
      ],
      "argsWindows": [
        "-3",
        ".chaos-engine/tool.py",
        "memory-mcp"
      ],
      "command": "python3",
      "commandWindows": "py",
      "cwd": "."
    },
    "chaosengine-mempalace": {
      "args": [
        ".chaos-engine/tool.py",
        "mempalace-mcp"
      ],
      "argsWindows": [
        "-3",
        ".chaos-engine/tool.py",
        "mempalace-mcp"
      ],
      "command": "python3",
      "commandWindows": "py",
      "cwd": ".",
      "env": {
        "MEMPALACE_BACKEND": "sqlite_exact",
        "MEMPALACE_EMBEDDING_MODEL": "minilm"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
