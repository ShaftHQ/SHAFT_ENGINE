<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.shafthq</groupId>
        <artifactId>shaft-parent</artifactId>
        <version>10.4.20261010</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>allure-cucumber8-jvm</artifactId>
    <packaging>jar</packaging>
    <name>Allure Cucumber JVM 8</name>
    <description>Cucumber JVM 8 Allure adapter redistributed from allure-java a1df39fffb1389ecbce951d617b5da3c49bb1a3a so shaft-engine resolves it from Maven Central.</description>
    <url>https://github.com/allure-framework/allure-java/pull/1455</url>
    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Mohab Mohie</name>
            <email>Mohab.MohieElDeen@outlook.com</email>
            <organization>GitHub</organization>
            <organizationUrl>https://github.com/ShaftHQ</organizationUrl>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/MohabMohie/allure-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/MohabMohie/allure-java.git</developerConnection>
        <url>https://github.com/MohabMohie/allure-java/tree/a1df39fffb1389ecbce951d617b5da3c49bb1a3a</url>
        <tag>a1df39fffb1389ecbce951d617b5da3c49bb1a3a</tag>
    </scm>

    <properties>
        <adapter.upstream.sha256>ace544ca18fa1839da535242a8150a0776198958f29ca242b75f3235ec34c36d</adapter.upstream.sha256>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>stage-upstream-adapter-classes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>python3</executable>
                            <arguments>
                                <argument>${project.basedir}/prepare_upstream_adapter.py</argument>
                                <argument>${project.build.directory}</argument>
                                <argument>${adapter.upstream.sha256}</argument>
                                <argument>--classes-only</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prepare-upstream-adapter</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>python3</executable>
                            <arguments>
                                <argument>${project.basedir}/prepare_upstream_adapter.py</argument>
                                <argument>${project.build.directory}</argument>
                                <argument>${adapter.upstream.sha256}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>use-upstream-adapter-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/upstream-adapter.jar"
                                      tofile="${project.build.directory}/${project.build.finalName}.jar"
                                      overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>adapter-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/upstream-src</classesDirectory>
                            <classifier>sources</classifier>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>adapter-javadoc</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/javadoc-out</classesDirectory>
                            <classifier>javadoc</classifier>
                            <includes>
                                <include>**/*</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
