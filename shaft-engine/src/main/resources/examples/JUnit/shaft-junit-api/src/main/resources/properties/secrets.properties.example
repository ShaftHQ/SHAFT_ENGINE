# REST Countries v5 API key used by TestClass (get one from your account at https://restcountries.com).
#
# Setup: copy this file to secrets.properties in this folder and replace the placeholder below.
# SHAFT loads every .properties file in this folder, so no extra configuration is needed.
# - Don't include the word "Bearer"; the test adds it.
# - Never commit secrets.properties (it is git-ignored), and don't put the key in custom.properties.
#
# Alternatives (checked in this order):
# 1. -DrestCountries.apiKey=<key> on the Maven command line (overrides this file).
# 2. The RESTCOUNTRIES_API_KEY environment variable. In GitHub Actions, add a repository secret
#    named RESTCOUNTRIES_API_KEY; .github/workflows/api.yml passes it to the tests.
restCountries.apiKey=rc_live_replace_with_your_key
